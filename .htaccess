# Dvatone: Apache / LiteSpeed (typical shared hosting). Upload to the web root next to index.html.
# Everything here is optional; each block is guarded so a missing module cannot break the site.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# Own 404 pages (Ukrainian site and English site)
ErrorDocument 404 /404.html

# HTTPS and one host name. Uncomment and put your real domain, then test.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType text/javascript .js .mjs
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml
</IfModule>

# Caching. HTML always revalidates; css/js carry ?v=<hash> in the page, so they may be cached for a year;
# fonts never change; images and 3D files get a week (replace a texture, and visitors see it within a week;
# add a new file name for an instant change).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^fonts\.css$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(?!fonts\.css$).*\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|webm|glb|ktx2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # The 3D modules import each other by plain file name (no ?v=): keep them on a short cache
  <FilesMatch "^(core|hero|interior|pack)\.js$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: enable only when HTTPS works on the whole domain
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# The forms handler must never be cached
<IfModule mod_headers.c>
  <Files "send.php">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# Do not serve the handler's local settings
<Files "config.php">
  Require all denied
</Files>
