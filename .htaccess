# Dvatone: Apache / LiteSpeed (typical shared hosting). Upload to the web root next to index.html.
# Everything here is optional; each block is guarded so a missing module cannot break the site.
# After upload, check the answers with curl -I (DEPLOY.md, section 6).

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# Own 404 pages (Ukrainian site and English site)
ErrorDocument 404 /404.html

# Send everybody to the secure (https) address. Why: the contact forms carry names, phones and e-mails, and without https
# anyone on the same Wi-Fi or network could read them on the way to the server (privacy law: data must be protected in
# transit). It needs a working certificate on the host first; if the site shows a certificate error after upload, ask the
# host to install the free certificate (Let's Encrypt) and only then keep this block.
# The second condition keeps it working when the host terminates https in front of Apache (a proxy or CDN that adds
# X-Forwarded-Proto); without it such a host would redirect forever.
# To keep one host name (with or without www), add another rule here with the real domain.

# The old web generator page no longer exists: the pages generator.html stay in the folder as a soft redirect (for hosts that ignore
# this file), and here they get a proper permanent redirect (301) to the app page, so search engines and old links move over.
# These two rules come first and go straight to https, so there is only one hop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^generator\.html$ https://%{HTTP_HOST}/app.html [L,R=301]
  RewriteRule ^en/generator\.html$ https://%{HTTP_HOST}/en/app.html [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType text/javascript .js .mjs
  AddType model/gltf-binary .glb
  AddType image/vnd.radiance .hdr
</IfModule>

# Compression (Apache 2.4 keeps AddOutputFilterByType in mod_filter). The 3D models (.glb) and HDR studio lights are
# included: meshopt data is made to be gzipped and comes out about 30 % smaller (the first-screen room: 794 KB to 548 KB).
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml model/gltf-binary image/vnd.radiance
  </IfModule>
</IfModule>

# Revalidate by date, not by ETag. Apache's compression appends -gzip to the ETag and then never answers a revalidation
# with 304 (the switch for that, DeflateAlterETag, works only in the server config). Without ETags the browser asks with
# If-Modified-Since, so unchanged pages and 3D files come back as a short 304 instead of a full download.
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

# Caching. HTML always revalidates. CSS and JS are loaded with ?v=<hash of the file>, and the build changes the hash
# whenever a file changes, so they may be cached for a year. Fonts never change. Images and video get a week
# (replace a picture, and visitors see it within a week; give it a new file name for an instant change).
# Two exceptions are checked with the server on every visit (a short 304 answer while nothing has changed),
# so an update reaches every visitor at once:
#   assets/3d/            no ?v= here: the modules import each other by plain file name, and the room data, models
#                         and textures are made for those modules, so the whole folder must arrive as one set;
#   assets/js/config.js   holds the form address and is edited on the server without a rebuild, so its ?v= stays the same.
# The last matching block wins: keep the two exceptions after the other blocks.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^fonts\.css$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(?!fonts\.css$).*\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|webm|glb|ktx2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/3d/" DV_REVALIDATE
    <FilesMatch ".">
      Header set Cache-Control "no-cache" env=DV_REVALIDATE
    </FilesMatch>
  </IfModule>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS tells the browser: for the next year talk to this site only over https. Why: after the first secure visit nobody can
  # trick the browser back to plain http. It is sent only on secure answers (the condition at the end of the line):
  # a browser ignores it on http anyway, and sending it there would be wrong. It lasts a year (31536000 seconds), so
  # make sure https works on the whole domain before the first deploy; do not add includeSubDomains or preload without a decision.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>

# The forms handler must never be cached
<IfModule mod_headers.c>
  <Files "send.php">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# Do not serve the handler's local settings
<Files "config.php">
  Require all denied
</Files>
